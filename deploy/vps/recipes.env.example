# Copied to /etc/recipes.env by install.sh. Fill in from the Vercel project's
# Environment Variables (values marked Sensitive have to be re-entered).
# Local Postgres on the VPS (deploy/vps/POSTGRES.md). The password is the one
# created for the recipes role; Postgres only listens on localhost.
DATABASE_URL=postgres://recipes:<password>@127.0.0.1:5432/recipes
ADMIN_EMAIL=
COOL_RECIPES_URL=https://recipes.antderosa.com
